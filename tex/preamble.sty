%% New commands
\newcommand{\figref}[1]{Fig.~\ref{#1}}
\newcommand{\tabref}[1]{Tab.~\ref{#1}}
\newcommand{\abbr}[1]{\textsc{\MakeLowercase{#1}}}
\newcommand{\todo}[1]{\textcolor{red}{\ttfamily\textbf{TODO} #1}}
\newcommand{\given}[1][]{\:#1\vert\:}
\newcounter{subfigure}
\counterwithin{subfigure}{figure}
\renewcommand{\thesubfigure}{%
  \thechapter.\the\numexpr\value{figure}+1\relax\alph{subfigure}%
}
\newcommand{\subcaption}[1]{%
  \refstepcounter{subfigure}
  \vskip.25\abovecaptionskip
  \sbox\@tempboxa{\small(\alph{subfigure})~#1}
  \ifdim\wd\@tempboxa>\hsize
    {\small(\alph{subfigure})~#1\par}
  \else
    \global\@minipagefalse
    \hb@xt@\hsize{\hfil\box\@tempboxa\hfil}%
  \fi
  \vskip\belowcaptionskip%
}
\makeatletter
\newcommand{\captionabove}[2][]{%
  \vskip-\abovecaptionskip
  \vskip+\belowcaptionskip
  \ifx\@nnil#1\@nnil
    \caption{#2}%
  \else
    \caption[#1]{#2}%
  \fi
  \vskip+\abovecaptionskip
  \vskip-\belowcaptionskip
}
\makeatother
